# FiftyFifty ToolKit - Environment Variables
# Copy this file to .env.local and fill in the values

# ===================================
# ADMIN PANEL CONFIGURATION
# ===================================
# Password for accessing the admin panel at /admin
# IMPORTANT: Change this to a strong password in production!
ADMIN_PASSWORD=1234

# ===================================
# SITE CONFIGURATION
# ===================================
# The public URL of your website (without trailing slash)
# Used for generating sitemaps, canonical URLs, and social media previews
NEXT_PUBLIC_SITE_URL=https://toolkit.fiftyfifty.org

# Environment (development, staging, production)
NODE_ENV=development

# ===================================
# DATABASE CONFIGURATION (Neon PostgreSQL via Vercel)
# ===================================
# These are automatically set when you connect Neon through Vercel Storage
# For local development, copy these values from your Vercel project settings
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ===================================
# EMAIL CONFIGURATION (Resend)
# ===================================
# Get your API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxx

# The email address to send contact form submissions from
# Use 'onboarding@resend.dev' for testing, or your verified domain email
RESEND_FROM_EMAIL=FiftyFifty ToolKit <onboarding@resend.dev>

# The email address to receive contact form submissions
CONTACT_EMAIL=contact@fiftyfifty.org