# Production Environment Variables for Vercel Deployment
# This file ensures the build succeeds even when CMS is not accessible

# Enable offline mode to use sample data during build
CMS_OFFLINE=1

# Site URL (will be overridden by Vercel's NEXT_PUBLIC_SITE_URL if set)
NEXT_PUBLIC_SITE_URL=https://toolkit.fiftyfifty.org

# ===================================
# ADMIN PANEL CONFIGURATION
# ===================================
# Password for accessing the admin panel at /admin
# IMPORTANT: Change this to a strong password in production!
ADMIN_PASSWORD=1234

# Recommended for most uses
DATABASE_URL=postgresql://neondb_owner:npg_igPYxvhj3mn2@ep-wispy-truth-ab266rk9-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:npg_igPYxvhj3mn2@ep-wispy-truth-ab266rk9.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Parameters for constructing your own connection string
PGHOST=ep-wispy-truth-ab266rk9-pooler.eu-west-2.aws.neon.tech
PGHOST_UNPOOLED=ep-wispy-truth-ab266rk9.eu-west-2.aws.neon.tech
PGUSER=neondb_owner
PGDATABASE=neondb
PGPASSWORD=npg_igPYxvhj3mn2

