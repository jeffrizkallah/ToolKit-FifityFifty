POSTGRES_URL=postgresql://neondb_owner:npg_igPYxvhj3mn2@ep-wispy-truth-ab266rk9-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://neondb_owner:npg_igPYxvhj3mn2@ep-wispy-truth-ab266rk9.eu-west-2.aws.neon.tech/neondb?sslmode=require
