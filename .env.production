POSTGRES_URL_NO_SSL=postgresql://neondb_owner:npg_igPYxvhj3mn2@ep-wispy-truth-ab266rk9-pooler.eu-west-2.aws.neon.tech/neondb
POSTGRES_PRISMA_URL=postgresql://neondb_owner:npg_igPYxvhj3mn2@ep-wispy-truth-ab266rk9-pooler.eu-west-2.aws.neon.tech/neondb?connect_timeout=15&sslmode=require

